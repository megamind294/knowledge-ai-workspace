# Required API configuration
DATABASE_URL=postgresql://keystone:keystone@localhost:5432/keystone
ACCESS_TOKEN_SECRET=
WEB_APP_URL=http://localhost:5173
PORT=4000
NODE_ENV=development
OBJECT_STORAGE_DIRECTORY=.data/objects

# Optional Google OAuth configuration; set all three values or leave all three unset.
# GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
# GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Optional embedding provider; the API key enables the internal ingestion service.
# The current pgvector schema requires exactly 1536 dimensions.
# EMBEDDING_API_KEY=
# EMBEDDING_ENDPOINT=https://api.openai.com/v1/embeddings
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_TIMEOUT_MS=15000

# Frontend configuration (set in the web process or its deployment environment)
VITE_API_URL=http://localhost:4000
# VITE_DATA_MODE=fixture
