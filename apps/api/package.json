{
  "name": "@knowledge-ai/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "lint": "eslint .",
    "typecheck": "npm run build --workspace @knowledge-ai/contracts && tsc --noEmit",
    "test": "npm run build --workspace @knowledge-ai/contracts && vitest",
    "evaluate:grounded:fixtures": "npm run build --workspace @knowledge-ai/contracts && vitest --run src/evaluation/groundedAnswerEvaluation.test.ts",
    "evaluate:grounded": "node -e \"if (!process.env.TEST_DATABASE_URL) { console.error('TEST_DATABASE_URL is required for grounded acceptance'); process.exit(1) }\" && npm run build --workspace @knowledge-ai/contracts && vitest --run src/evaluation/groundedAnswerEvaluation.test.ts src/conversations/postgresConversationRepository.test.ts src/retrieval/postgresRetrievalRepository.test.ts",
    "build": "npm run build --workspace @knowledge-ai/contracts && tsc --project tsconfig.build.json"
  },
  "dependencies": {
    "@knowledge-ai/contracts": "0.1.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.1.0",
    "htmlparser2": "12.0.0",
    "jose": "^6.2.10",
    "mammoth": "1.12.2",
    "pdfjs-dist": "5.5.207",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.1",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "pg-mem": "^3.0.5",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
