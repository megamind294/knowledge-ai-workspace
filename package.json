{
  "name": "knowledge-ai-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @knowledge-ai/web",
    "lint": "npm run lint --workspace @knowledge-ai/web",
    "typecheck": "npm run typecheck --workspace @knowledge-ai/web",
    "test": "npm run test --workspace @knowledge-ai/web --",
    "build": "npm run build --workspace @knowledge-ai/web"
  }
}
